            "date": "={{ $fromAI('date', ``, 'string') }}",
            "name": "={{ $fromAI('name', ``, 'string') }}",
            "calories": "={{ $fromAI('calories', ``, 'string') }}",
            "carbohydrate": "={{ $fromAI('carbohydrate', ``, 'string') }}",
            "protein": "={{ $fromAI('protein', ``, 'string') }}",
            "fat": "={{ $fromAI('fat', ``, 'string') }}"
          }
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.7,
      "position": [
        420,
