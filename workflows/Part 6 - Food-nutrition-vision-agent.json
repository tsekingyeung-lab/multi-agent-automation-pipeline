          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "=# 使用此工具,加總今日攝取的總熱量和3大營養素\n- 用法:使用今日日期\"{{ $now.format('yyyy-MM-dd') }}\",於google sheet中取得今日所攝取的食物項目資料並加總今日攝取的總熱量和3大營養素",
